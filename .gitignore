# ══════════════════════════════════════════
#  AdminApp · Monorepo .gitignore
# ══════════════════════════════════════════

# ── Node ──
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment ──
# Nunca commitear secrets. Ver .env.example para la lista de variables.
.env
.env.local
.env.*.local
!.env.example

# ── Build / Dist ──
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ── Uploads (efimeros, no van al repo) ──
apps/api/uploads/
apps/api/src/uploads/
apps/web/public/uploads/

# ── Logs ──
*.log
logs/

# ── Test coverage ──
coverage/

# ── Deploy / plataformas ──
.vercel
.railway

# ── Editor ──
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ──
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Temporales / debug ──
*.local
mapping_debug.txt
test_*.csv
tmp_*.js
