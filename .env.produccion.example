# ══════════════════════════════════════════════════════════════
#  Favalio · Variables del VPS
#
#  Este archivo es la plantilla del `.env` que vive EN EL SERVIDOR, al lado de
#  docker-compose.produccion.yml. No es el mismo que `.env.example`: aquel
#  documenta las variables de las tres apps en desarrollo; este arma la pila
#  entera de producción.
#
#  En el VPS:
#      cp .env.produccion.example .env
#      nano .env
#      chmod 600 .env
#
#  El `.env` real NUNCA se commitea (está en .gitignore).
# ══════════════════════════════════════════════════════════════


# ── Dominio ───────────────────────────────────────────────────
# Sin https:// y sin barra. De acá salen solos los tres nombres:
# favalio.com, www.favalio.com, app.favalio.com y api.favalio.com.
DOMINIO=favalio.com

# Let's Encrypt avisa a esta casilla si la renovación de un certificado falla.
EMAIL_TLS=hola@favalio.com


# ── Base de datos ─────────────────────────────────────────────
# La contraseña la genera el servidor, no una persona:
#     openssl rand -base64 32
#
# ⚠ Se usa SOLO en la primera creación del volumen. Cambiarla después no
#   cambia la contraseña dentro de Postgres: eso se hace con ALTER USER.
POSTGRES_USER=favalio
POSTGRES_PASSWORD=
POSTGRES_DB=favalio


# ── Auth0 ─────────────────────────────────────────────────────
# Sin estas dos la API aborta al arrancar.
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.favalio.com

# El CLIENT_ID es público por diseño (va dentro del bundle del navegador).
# El CLIENT_SECRET no se usa en ningún lado: el flujo es PKCE.
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.favalio.com


# ── Email transaccional (Resend) ──────────────────────────────
# Sin esto no salen los mails de bienvenida ni las invitaciones de equipo.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@favalio.com

# Contacto de la landing («Hablar con ventas», «Agenda una demo»).
VITE_CONTACT_EMAIL=hola@favalio.com


# ── Opcionales ────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Timeout de las llamadas del navegador a la API, en ms. En el VPS el proceso
# no duerme, así que no hace falta el margen de 60s que pedía el free tier de
# Render.
VITE_API_TIMEOUT=20000

TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_CONTACT_EMAIL=

# Extracción de productos por IA.
ANTHROPIC_API_KEY=

# Aviso de errores por mail (sentry.io, plan gratuito 5.000 eventos/mes).
SENTRY_DSN=

# Habilita POST /api/tareas/ejecutar para dispararlo desde afuera. En el VPS el
# cron interno ya corre, así que esto es un respaldo, no un requisito.
CRON_SECRET=
