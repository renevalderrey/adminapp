{
  "name": "favalio-api",
  "version": "1.0.0",
  "description": "Favalio · API Backend — Node.js + Express + PostgreSQL + Auth0",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrar.js",
    "db:migrate": "node scripts/migrar.js",
    "migrar:legacy": "node scripts/migrar-legacy.js",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo --config src/config/sequelize-cli.js --migrations-path src/migrations",
    "test": "jest --forceExit --detectOpenHandles --testPathIgnorePatterns \"/node_modules/\" \"\\.integracion\\.test\\.js$\"",
    "test:integracion": "node src/tests/integracion/prepararBase.js && jest --runInBand --forceExit --testPathPatterns \"\\.integracion\\.test\\.js$\"",
    "test:db:levantar": "node src/tests/integracion/prepararBase.js --levantar",
    "test:db:migrar": "node src/tests/integracion/prepararBase.js",
    "test:db:bajar": "docker rm -f favalio-pg-integracion",
    "test:watch": "jest --watch --testPathIgnorePatterns \"/node_modules/\" \"\\.integracion\\.test\\.js$\"",
    "test:coverage": "jest --coverage --testPathIgnorePatterns \"/node_modules/\" \"\\.integracion\\.test\\.js$\"",
    "db:migrate:raw": "npx sequelize-cli db:migrate --config src/config/sequelize-cli.js --migrations-path src/migrations",
    "verificar:esquema": "node scripts/verificar-esquema.js",
    "backup": "node scripts/backup.js",
    "informe:stock": "node scripts/informe-stock-sucursal.js",
    "suscripcion": "node scripts/suscripcion.js",
    "superadmin": "node scripts/superadmin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@favalio/precios": "*",
    "@sentry/node": "^10.69.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.8.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-forge": "^1.4.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.12.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "soap": "^1.9.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
