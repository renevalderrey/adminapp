# ══════════════════════════════════════════════════════════════
#  Favalio · Caddy (proxy inverso + TLS)
#
#  {$DOMINIO} y {$EMAIL_TLS} salen del .env, vía docker-compose.produccion.yml.
#
#  Caddy pide los certificados a Let's Encrypt la primera vez que alguien
#  entra por HTTPS, y los renueva solo. Para que funcione, los dominios TIENEN
#  que resolver ya al VPS: si el DNS todavía no propagó, el pedido falla y
#  Caddy reintenta con espera creciente.
#
#  Redirección http → https: automática, no se configura.
# ══════════════════════════════════════════════════════════════
{
	# Dirección a la que Let's Encrypt avisa si un certificado está por vencer
	# y la renovación viene fallando.
	email {$EMAIL_TLS}
}

# ── Landing ──
{$DOMINIO} {
	encode gzip
	reverse_proxy landing:80

	# HSTS: una vez que el navegador vio esta cabecera, no vuelve a intentar
	# por http. Se activa recién cuando el sitio ya anda por https.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# ── www → raíz ──
# Redirigir en vez de servir dos veces lo mismo: un solo contenido, una sola
# URL canónica.
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# ── Aplicación ──
app.{$DOMINIO} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Las fotos, también acá.
	#
	# El panel guarda en `products.image_url` la ruta RELATIVA `/img/aa/bb/…`, y
	# la ficha del producto la dibuja tal cual. Si `/img/` sólo existiera en
	# `tienda.`, el administrador vería un 404 en cada miniatura mientras el
	# cliente ve la foto perfecta — y el dato estaría bien, así que nadie
	# encontraría la causa.
	#
	# Es el mismo volumen y el mismo bloque que en `tienda.`: de sólo lectura,
	# servido por Caddy y no por la API.
	handle /img/* {
		uri strip_prefix /img
		root * /var/favalio/imagenes
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		reverse_proxy web:80
	}
}

# ── API ──
# `encode` acá sí importa: la API no tiene middleware de compresión, y algunas
# respuestas (listados de inventario, exportaciones) son JSON grande.
api.{$DOMINIO} {
	encode gzip
	reverse_proxy api:5000
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# ── Tienda ──
#
# El sitio nace con UN solo `handle`: el de las imágenes. Los otros tres —el
# HTML de /c/:slug con sus metadatos, el bundle de apps/tienda y el resto—
# entran con el servicio, más adelante en el hito.
#
# ⚠ El `X-Robots-Tag` es de SITIO y no de una ruta, a propósito. El precio que
# una empresa negoció con un socio se publica en una URL sin login: que no
# termine en un buscador es una decisión de producto, y ponerlo por ruta deja la
# puerta abierta a que la próxima ruta nazca sin él.
tienda.{$DOMINIO} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Robots-Tag "noindex, nofollow"

	# Las fotos salen del volumen, no de la API.
	#
	# El prefijo público es `/img/` y el volumen está montado en
	# `/var/favalio/imagenes`: `strip_prefix` es lo que une las dos cosas. Sin
	# él, Caddy buscaría `/var/favalio/imagenes/img/aa/bb/…` y devolvería 404
	# para todas las fotos.
	handle /img/* {
		uri strip_prefix /img
		root * /var/favalio/imagenes
		file_server

		# El nombre del archivo es aleatorio y nunca se reusa: una foto que
		# cambia es una URL nueva. Así que se puede cachear para siempre.
		header Cache-Control "public, max-age=31536000, immutable"
	}
}
