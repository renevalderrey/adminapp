# ══════════════════════════════════════════════════════════════
#  AdminApp · Variables de entorno
#
#  Este archivo es la referencia unica de las tres apps. Cada app lee
#  su propio .env local:
#
#    apps/api/.env       <- bloque API
#    apps/web/.env       <- bloque WEB
#    apps/landing/.env   <- bloque LANDING
#
#  En produccion las variables se cargan en el dashboard de cada
#  plataforma (Render para la API, Vercel para web y landing), no desde
#  archivos. Nunca commitear un .env con valores reales.
#
#  RUNTIME vs BUILD-TIME:
#    Las VITE_* se hornean en el bundle durante el build. Cambiar una
#    exige rebuildear y redesplegar; no alcanza con editar la variable.
#    Las de la API se leen en cada arranque del proceso.
# ══════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════
#  API  (apps/api)  ->  Render
# ══════════════════════════════════════════════════════════════

NODE_ENV=development
# El PaaS inyecta PORT. En local, 5000.
PORT=5000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Base de datos ──
# Opcion A (recomendada, y la que usan Neon/Render/Railway): un solo string.
# Si esta definida, tiene prioridad sobre las DB_* de abajo.
# En Neon usar el endpoint *pooled* — el host termina en "-pooler".
DATABASE_URL=postgresql://usuario:password@host.neon.tech/adminapp?sslmode=require

# Opcion B: conexion por partes. Solo se usa si DATABASE_URL esta vacia.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adminapp
DB_USER=postgres
DB_PASS=
# Poner en "false" para desactivar SSL (Postgres local). Cualquier otro valor
# lo deja activo, que es lo que necesitan Neon y Render.
DB_SSL=false

# ── Auth0 ──
# OBLIGATORIAS: si falta alguna, el server aborta al arrancar.
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.sistema-de-facturacion.com

# Saltea la validacion de JWT y hardcodea empresa_id=1.
# SOLO desarrollo local. checkPermission lo bloquea si NODE_ENV=production.
BYPASS_AUTH=false

# ── CORS ──
# Lista separada por comas de los origenes permitidos (app + landing).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# URL de la app. Se usa en CORS y en los links de los emails.
FRONTEND_URL=http://localhost:5173
# URL de la landing.
LANDING_URL=http://localhost:5174
# Opcional: regex para permitir los deploy previews de Vercel.
# Ej: ^https://adminapp-web-.*\.vercel\.app$
VERCEL_PREVIEW_PATTERN=

# ── Email transaccional (Resend) ──
# Sin esto no salen los mails de bienvenida ni las invitaciones de equipo.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@tudominio.com

# ── TiendaNube (opcional) ──
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_CONTACT_EMAIL=

# ── Migracion legacy PHP -> PostgreSQL (opcional) ──
# Solo para el script one-off apps/api/src/migrate.js.
PHP_API_URL=
PHP_API_TOKEN=

# ── Disparador externo de tareas programadas ──
# El cron de suscripciones corre dentro del proceso, y en un free tier que
# duerme el servicio no dispara de forma confiable. Con este secreto se
# habilita POST /api/tareas/ejecutar, que un cron externo puede llamar
# mandando la cabecera X-Cron-Secret.
# Sin la variable, el endpoint responde 404.
#
# El workflow .github/workflows/tareas-diarias.yml lo llama una vez por dia.
# El mismo valor va como secreto API_URL/CRON_SECRET del repositorio.
CRON_SECRET=

# ── Aviso de errores (opcional) ──
# Sin SENTRY_DSN no se inicializa nada y el sistema funciona igual: los errores
# quedan solo en el log. Con la variable, cada 500 y cada caida del proceso
# llegan por mail. Plan gratuito de sentry.io: 5.000 eventos por mes.
SENTRY_DSN=

# ── Migracion desde el sistema legacy (Comprafit PHP) ──
# Solo para apps/api/scripts/migrar-legacy.js. Sin estas dos, el script cae al
# HTML del repo, que tiene los datos SEMILLA y no los actuales.
PHP_API_URL=
PHP_API_TOKEN=

# ── Script de importacion por CSV (opcional) ──
# Solo para apps/api/scripts/import-from-csv.js.
CSV_PATH=./import.csv
EMPRESA_ID=1


# ══════════════════════════════════════════════════════════════
#  WEB  (apps/web)  ->  Vercel
#  Todas se hornean en el build.
# ══════════════════════════════════════════════════════════════

# Incluye el sufijo /api.
VITE_API_URL=http://localhost:5000/api

# Timeout de las llamadas HTTP, en ms. El default de 60s cubre el cold start
# del free tier de Render (~50s). Bajar cuando haya plan pago.
VITE_API_TIMEOUT=60000

# ── Auth0 (frontend, flujo PKCE) ──
# El CLIENT_ID es publico por diseno. Nunca poner el CLIENT_SECRET aca.
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Tiene que coincidir exactamente con AUTH0_AUDIENCE de la API.
VITE_AUTH0_AUDIENCE=https://api.sistema-de-facturacion.com


# ══════════════════════════════════════════════════════════════
#  LANDING  (apps/landing)  ->  Vercel
#  Todas se hornean en el build.
# ══════════════════════════════════════════════════════════════

# A donde apuntan los CTA de la landing.
VITE_APP_URL=http://localhost:5173

# Email de los links de contacto ("Hablar con ventas", "Agenda una demo").
VITE_CONTACT_EMAIL=hola@adminapp.com
